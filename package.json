{
  "name": "kuaimai-agent-connector",
  "version": "0.7.0",
  "description": "Local Agent bridge for Kuaimai and Lingtong with Codex, Qwen and WorkBuddy CLI sessions",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littercarp16/kuaimai-agent-connector.git"
  },
  "homepage": "https://github.com/littercarp16/kuaimai-agent-connector#readme",
  "bugs": {
    "url": "https://github.com/littercarp16/kuaimai-agent-connector/issues"
  },
  "bin": {
    "kuaimai-agent": "bin/kuaimai-agent.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "web/",
    "browser-extension/",
    "skills/km-agent-bridge/",
    "workspace/README.md",
    "*.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "os": [
    "darwin"
  ],
  "type": "module",
  "scripts": {
    "start": "node main.mjs",
    "codex:desktop": "node codex-desktop.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "build:macos": "node desktop/build-macos.mjs",
    "build:extension": "node desktop/build-extension.mjs",
    "test:desktop": "node --test tests/desktop/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@opencode/client": "2.0.30",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
