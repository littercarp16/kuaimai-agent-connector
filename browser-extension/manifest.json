{
  "manifest_version": 3,
  "name": "快麦本地 Agent 连接",
  "description": "让绫通 HTTP 测试与开发页面在原页面连接本机 Agent，不经过服务器中继。",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["http://lt.com/*", "http://local.lt.com/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
